{
  "manifest_version": 3,
  "name": "FBM Finder — Facebook Marketplace Deal Finder",
  "version": "1.0.0",
  "description": "Enter the products you want and how good a deal you want. Scans Facebook Marketplace in your area and shows the top 10 deals with links.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["*://*.facebook.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FBM Finder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
